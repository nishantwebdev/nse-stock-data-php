{
    "name": "nishantwebdev/nse-stock-data-php",
    "description": "A comprehensive PHP library for accessing NSE (National Stock Exchange) India stock market data",
    "type": "library",
    "keywords": [
        "nse",
        "stock",
        "market",
        "india",
        "api",
        "finance",
        "trading",
        "stock-data",
        "nse-india",
        "nse-india-stock-data",
        "php-sdk"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Nishant Patel",
            "email": "hello@nishantwebdev.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "nesbot/carbon": "^3.10",
        "guzzlehttp/guzzle": "^7.9"
    },
    "autoload": {
        "psr-4": {
            "NseData\\StockClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NseData\\StockClient\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "scripts": {
        "test": "phpunit tests/"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
